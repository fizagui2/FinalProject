# Copy this file to .env at the repo root and fill in the real values.
# .env is gitignored -- never commit real credentials. The repo is public.
# Ask the team for the Supabase values; everyone uses the same shared database.

# Django
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Postgres
# Get these from the Supabase dashboard: Connect -> ORM / Direct connection.
# Use the SESSION POOLER (port 5432) unless you know you need otherwise --
# Supabase's direct connection is IPv6 only on the free tier, and the
# transaction pooler (6543) has caveats for migrations.
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
